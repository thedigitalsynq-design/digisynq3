# DigiSynq Cinema Unified — Environment Configuration
# Copy to .env and fill in secrets. Never commit .env.
NODE_ENV=development
PORT=3000

# Required in production
SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me-immediately

# Optional integrations
GEMINI_API_KEY=
TMDB_API_KEY=
TMDB_ACCESS_TOKEN=

# CORS: comma-separated allowed origins. Empty = reflect request origin (dev).
# Example: CORS_ORIGIN=https://app.example.com,https://admin.example.com
CORS_ORIGIN=

# Trust X-Forwarded-* headers when behind a reverse proxy (set to 1 in prod behind proxy)
TRUST_PROXY=0

# Cap concurrent SSE live-stream clients
MAX_SSE_CLIENTS=200

# Firebase (Vite client — use VITE_ prefix; values are public client keys, not secrets.
# Real access control lives in firestore.rules, which denies writes by default.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
