rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny: reads allowed for public catalog data, writes require auth.
    // Tighten per-collection (e.g. request.auth != null && request.auth.token.admin == true)
    // once Firebase Auth roles are wired up.
    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
